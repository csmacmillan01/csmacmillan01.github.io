---
import Layout from "../layouts/Layout.astro";
import Professional from "../components/Professional.astro";
import WM from "../components/WM.astro";
import Beyond from "../components/Beyond.astro";
import Connect from "../components/Connect.astro";
---

<Layout>
  <div class="tabs" style="min-height: 500px; position: relative;">

    <section id="professional" class="tab-content active">
      <Professional />
    </section>

    <section id="wm" class="tab-content">
      <WM />
    </section>

    <section id="beyond" class="tab-content">
      <Beyond />
    </section>

    <section id="connect" class="tab-content">
      <Connect />
    </section>

  </div>
</Layout>

<script>
  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      const navLinks = document.querySelectorAll("nav a");

      navLinks.forEach(link => {
        link.addEventListener("click", (e) => {
          e.preventDefault();

          const target = link.getAttribute("data-tab");
          const current = document.querySelector(".tab-content.active");
          const next = document.getElementById(target);

          if (!next || next === current) return;

          // fade out current
          current.classList.remove("active");

          // fade in next after small delay
          setTimeout(() => {
            next.classList.add("active");
          }, 400); // matches fade duration
        });
      });
    });
  }
</script>

<style>
  .tabs {
  position: relative;
}

.tab-content {
  position: absolute;
  inset: 0;
  width: 100%;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
}

.tab-content.active {
  opacity: 1;
  pointer-events: auto;
  position: relative; /* KEY LINE */
}
</style>