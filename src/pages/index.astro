---
import Layout from "../layouts/Layout.astro";
import Professional from "../components/Professional.astro";
import WM from "../components/WM.astro";
import Beyond from "../components/Beyond.astro";
import Connect from "../components/Connect.astro";
---

<Layout>
  <div class="tabs" style="min-height: 500px; position: relative;">

    <section id="professional" class="tab-content active">
      <Professional />
    </section>

    <section id="wm" class="tab-content">
      <WM />
    </section>

    <section id="beyond" class="tab-content">
      <Beyond />
    </section>

    <section id="connect" class="tab-content">
      <Connect />
    </section>

  </div>
</Layout>

<script>
  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      const navLinks = document.querySelectorAll("nav a");

      navLinks.forEach(link => {
  link.addEventListener("click", (e) => {
    e.preventDefault();

    const target = link.getAttribute("data-tab");
    const currentTab = document.querySelector(".tab-content.active");
    const nextTab = document.getElementById(target);
    const currentNav = document.querySelector("nav a.active");

    if (!nextTab || nextTab === currentTab) return;

    // Fade out current
    currentTab.style.opacity = "0";
    currentNav?.classList.remove("active");

    setTimeout(() => {
      currentTab.classList.remove("active");
      nextTab.classList.add("active");

      // ensure fade in starts clean
      nextTab.style.opacity = "1";
      link.classList.add("active");
    }, 400); // match your CSS transition time
  });
});
    });
  }
</script>

<style>
  .tabs {
  position: relative;
}

.tab-content {
  position: absolute;
  inset: 0;
  width: 100%;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
}

.tab-content.active {
  opacity: 1;
  pointer-events: auto;
  position: relative; /* KEY LINE */
}

